# Public site URL used for OG images and metadata.
# Vercel production deployments always use https://www.ai3.info for
# canonicals, the sitemap and llms.txt; this value applies everywhere else.
NEXT_PUBLIC_URL=http://localhost:3000

# Google Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Vercel KV (server-side only)
KV_REST_API_URL=
KV_REST_API_TOKEN=